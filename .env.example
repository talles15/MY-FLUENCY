# Copie para .env (local) e cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).
# Nunca faça commit do .env.

# --- Claude (análise de gramática e vocabulário) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FREE=claude-haiku-5-5     # conversa livre (barato)
ANTHROPIC_MODEL_TEST=claude-sonnet-5-5    # teste de nível (define o nível oficial)

# --- Azure Speech (pronúncia, fluência e transcrição) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth

# --- Supabase (banco, áudios e login) ---
# Project Settings → API. Sem estas três, o app roda local com SQLite e sem login.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=     # chave pública (sb_publishable_... ou a antiga "anon"); vai para o navegador
SUPABASE_SECRET_KEY=          # chave secreta (sb_secret_... ou a antiga "service_role"); SÓ no servidor
ALLOWED_EMAILS=               # e-mail(s) que podem entrar, separados por vírgula

# --- Opcionais ---
APP_TIMEZONE=America/Sao_Paulo
PORT=3001
DB_PATH=data/voz-clara.db     # só no modo local
AUDIO_DIR=data/audio          # só no modo local
